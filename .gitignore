# ---- Gradle ----
.gradle/
build/
# IntelliJ Platform Gradle Plugin 的本地缓存（IDE 元数据、布局索引等）
.intellijPlatform/

# ---- IntelliJ / PyCharm ----
# .idea/ 整体忽略：Gradle 项目的一切构建配置均由 build.gradle.kts 定义，
# IDE 侧配置可随时重新生成。且 .idea/claudeCodeTabState.xml 含个人会话 ID，
# 不应进版本库。
.idea/
*.iml
out/

# ---- Node / sidecar ----
node_modules/
npm-debug.log*
.npm/

# ---- web 前端 ----
# node_modules/ 与 coverage/ 已由上面的通用规则覆盖，
# 这里只需补构建产物目录
web/dist/

# ---- Kotlin / JVM ----
*.class
*.jar
*.kotlin_module
# wrapper jar 必须入库，否则 clone 后 ./gradlew 不可用。
# 位置有意放在 *.jar 之后 —— Git 中后面的规则胜出，放前面会被 *.jar 覆盖。
!gradle/wrapper/gradle-wrapper.jar

# ---- 构建产物 ----
*.zip

# ---- 测试与覆盖率 ----
coverage/
*.exec

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 日志与临时文件 ----
*.log
*.tmp
# JVM 堆转储：IDE 崩一次就在仓库根落一个 1GB+ 的文件，
# 而它在 `git status` 里是未跟踪状态 —— 不挡一道，某次 `git add -A` 就把它带进去了
*.hprof

# 冒烟测试产物
sidecar/smoke.jsonl
sidecar/smoke.err

# TypeScript 增量构建信息（tsc -b 产生）
web/*.tsbuildinfo

# Kotlin 增量编译产生的会话目录
.kotlin/

# ---- 工具 ----
# CodeGraph 的本地索引库。它是**本机产物**：内容取决于当前工作区状态、
# 随时被重建，且体积不小 —— 进版本库只会每台机器都冲突一遍。
.codegraph/
