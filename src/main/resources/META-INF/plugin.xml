<idea-plugin>
    <id>com.ccoder.claudecode</id>
    <!-- 名字的**真正来源**是 gradle.properties 的 pluginName（patchPluginXml 会拿它
         覆盖这一行）。两处都写同样的值，免得看 plugin.xml 的人以为改这里就行。
         括号是市场指南 ✅ 栏里点名允许的符号；带上 "Claude Code" 是为了能搜到
         （2026-09-15，理由见 docs 里那次搜索实测）。 -->
    <name>CCoder (Claude Code Assistant)</name>
    <!-- 市场审核指南要"vendor 网站有效可访问、邮箱有效"。邮箱填了（git 里的提交邮箱）；
         url 空着：没有主页也没有公开仓库（2026-09-15 确认），不编一个指到别人家的网址。
         若审核因此打回，补一个 url="..." 即可。名字 ccoder 是插件页上显示的那个。 -->
    <vendor email="594954848@qq.com">ccoder</vendor>

    <description><![CDATA[
    Runs the Claude Code CLI inside a PyCharm tool window: ask against the project
    you are already editing, see every file edit as a diff before it is applied,
    and approve or deny the commands that touch your machine.

    Requires the Claude Code CLI (claude) and Node.js installed on your machine.
    ]]></description>

    <!-- 口径：**只写相对上一个已上架版本（0.2.17）的增量**，中英各一份（§八）。 -->
    <change-notes><![CDATA[
    <h3>0.2.18</h3>
    <ul>
      <li><b>Clear the session from the card</b> &mdash; a broom sits in the corner of the Connection card: one click starts a fresh session, exactly like typing <code>/clear</code>. Nothing is deleted &mdash; the old session stays on disk.</li>
      <li><b>Compact from the card</b> &mdash; the Context card gets a matching icon for <code>/compact</code>, so it is one click away instead of a command you have to remember. While it runs, that card says "Compacting&hellip;".</li>
      <li><b>A receipt for every compaction</b> &mdash; when it finishes, the transcript shows what it bought you: <code>31.5k &rarr; 1.6k (17s)</code>.</li>
      <li><b>Links are readable again</b> &mdash; transcript link and tool-badge colors are now picked by contrast against the bubble background. The old blue measured 2.5:1 on dark themes: visible, but not readable.</li>
    </ul>

    <h4>中文</h4>
    <ul>
      <li><b>卡上直接清空会话</b> &mdash;&mdash; 连接卡右上角多了一颗扫把：点一下就是开一条新会话，与敲 <code>/clear</code> 完全同一条路。<b>不删任何东西</b>，旧会话还在磁盘上。</li>
      <li><b>卡上直接压缩上下文</b> &mdash;&mdash; 上下文卡多了一颗对应的图标（＝ <code>/compact</code>），不用再记命令；压缩期间那一格写「压缩中…」。</li>
      <li><b>压缩完给一张回执</b> &mdash;&mdash; 转写区会写一行 <code>31.5k → 1.6k（用时 17s）</code>，这次压得值不值一眼看得见。</li>
      <li><b>链接读得清了</b> &mdash;&mdash; 转写区里链接与工具徽标的颜色改成按对比度挑：深色主题下原来那一支对气泡底只有 <b>2.5:1</b>，看得见、读不了。</li>
    </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <!-- 转写区用内嵌浏览器渲染。该别名自 2025.3.1 起稳定。 -->
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!--
          设置**没有**注册在这里，是刻意的（2026-09-15 删掉了那个 projectConfigurable）。
          全部设置都在工具窗口右上角那个齿轮里（`com.ccoder.settings.SettingsDialog`，
          四个页签：模型 / 通用 / 权限 / 环境）—— 从前这里有一页 IDE 设置，
          与对话框各管一半字段，用户得记"哪项在哪儿"。

          代价知道：IDE Settings 的搜索框里再也搜不到 CCoder。而齿轮**不随忙闲置灰**，
          所以"启动失败时进不去改 claudePath"这条链没断（见 ClaudePanel.settingsButton）。
        -->

        <!-- 图标是自己的（2026-09-15）：小 C 套大 C，与插件图标
             （META-INF/pluginIcon.svg）同一张脸。13px 那份不带方块底、
             内圈与外壳同色，理由见 icons/ccoderToolWindow.svg 的注释。
             深色主题那份走 _dark 后缀，平台自己按主题挑。 -->
        <!-- canCloseContents **刻意保持 false**（2026-09-16）：
             标签条与关闭叉改由面板自己画（`SessionChips` 那排胶囊），平台的
             ✕ 与我们自己的 ✕ 同时出现就重复了。关闭逻辑一个字没变 —— 我们那颗 ✕
             走的还是 `ContentManager.removeContent`，于是 `contentRemoveQuery`
             那道闸（忙 / 有待决权限 / 正在启动时先问一句）照旧生效。
             这个标志也**只能写在这儿**：`ToolWindow` 接口上只有 getter，
             `ToolWindowImpl` 里是 `private final boolean`。 -->
        <toolWindow
            id="CCoder"
            anchor="right"
            icon="/icons/ccoderToolWindow.svg"
            factoryClass="com.ccoder.ClaudeToolWindowFactory"/>

        <!-- 待决权限在状态栏常驻显示。
             2026-09-14 改成模态框之后，§6.3 原本那两条补偿（粘性通知、
             待决超时提醒）连同 "CCoder Permissions" 通知组一起删掉了：
             框会自己弹到眼前，"被忽略"这件事在模态形态下不存在。
             这个状态栏计数留着 —— IDE 不在前台时它仍是唯一线索。 -->
        <statusBarWidgetFactory
            id="CCoderPendingPermissions"
            implementation="com.ccoder.ui.PendingPermissionStatusBarFactory"/>

        <!-- 转写区里点文件名却打不开时的提示（见 OpenFileTarget）。
             这里是**非粘性**的：那只是"这一次没打开"，不是需要用户处理的
             待办 —— 留一张撕不掉的气球就成了打扰。 -->
        <notificationGroup
            id="CCoder"
            displayType="BALLOON"
            isLogByDefault="false"/>
        <!-- 同一条快捷键上平台也有一个（$Paste）：焦点在我们的输入框时，把这个排前面。
             **必须在 extensions 里** —— 写在顶层会被静默忽略（这一条差点没赶上）。 -->
        <actionPromoter implementation="com.ccoder.ui.ImagePastePromoter"/>
    </extensions>

    <actions>
        <!-- 编辑器右键：把选中代码加到输入框。
             2026-09-14 起输入框里放的是**一行记号**（⟦路径 行范围 · N 行⟧），
             完整片段在发送时才展开 —— 选 30 行不再顶掉 30 行输入框。
             排在最上面（anchor="first"），没有选区时由 update() 置灰。 -->
        <action
            id="com.ccoder.AddSelectionToChat"
            icon="/icons/ccoderAction.svg"
            class="com.ccoder.ui.AddSelectionToChatAction"
            text="添加到 CCoder 聊天框"
            description="把选中的代码加到 CCoder 输入框（显示为一行记号，发送时展开）">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

        <!-- 编辑器右键：整个文件。**没有选区时也能用** —— 想引用一整个文件，
             以前只能全选再右键，而全选出的是"这个文件的全部行"。 -->
        <action
            id="com.ccoder.AddFileToChat"
            icon="/icons/ccoderAction.svg"
            class="com.ccoder.ui.AddFileToChatAction"
            text="添加整个文件到 CCoder 聊天框"
            description="把这个文件作为 @ 引用加到 CCoder 输入框（内容由 CLI 展开）">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

        <!-- 项目树右键：多选一次全加。在树里挑文件比"开文件再右键"自然得多。 -->
        <action
            id="com.ccoder.AddFilesToChat"
            icon="/icons/ccoderAction.svg"
            class="com.ccoder.ui.AddFilesToChatAction"
            text="添加文件到 CCoder 聊天框"
            description="把选中的文件作为 @ 引用加到 CCoder 输入框">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </action>

        <!-- Ctrl+V 贴图。**只在"焦点在输入框、剪贴板里只有图"时可见**（见
             PasteImageAction 的说明）—— 其余时候它不是候选，Ctrl+V 归平台原来那套，
             文字粘贴一个字不变。 -->
        <action
            id="com.ccoder.PasteImage"
            class="com.ccoder.ui.PasteImageAction"
            text="贴图"
            description="把剪贴板里的截图贴进输入框">
            <keyboard-shortcut keymap="$default" first-keystroke="control V"/>
        </action>
    </actions>

</idea-plugin>
